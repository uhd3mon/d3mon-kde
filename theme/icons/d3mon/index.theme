[Icon Theme]
Name=d3mon
Comment=d3mon folder icons (everything else from Breeze Dark)
Inherits=breeze-dark,breeze,hicolor
Example=folder
Directories=places/symbolic,places/scalable

# Line icons for small sizes (Dolphin sidebar, details view);
# recoloured by KDE through the ColorScheme-Text class.
[places/symbolic]
Size=22
MinSize=16
MaxSize=31
Context=Places
Type=Scalable

[places/scalable]
Size=64
MinSize=32
MaxSize=512
Context=Places
Type=Scalable
